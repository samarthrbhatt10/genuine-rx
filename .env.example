# ==============================================================================
#  Genuine RX — Environment Variables Template
#  Copy this file to .env and fill in real values. Never commit .env.
# ==============================================================================

# --- Database ---
GENUINE_RX_DB_URL=postgresql+psycopg://user:password@localhost:5432/genuine_rx

# --- Redis ---
GENUINE_RX_REDIS_URL=redis://localhost:6379/0

# --- Twilio (WhatsApp / SMS delivery) ---
GENUINE_RX_TWILIO_ACCOUNT_SID=
GENUINE_RX_TWILIO_AUTH_TOKEN=
GENUINE_RX_TWILIO_FROM_NUMBER=whatsapp:+14155238886

# --- API server ---
GENUINE_RX_API_HOST=0.0.0.0
GENUINE_RX_API_PORT=8000

# --- RPA scheduler ---
# Cron expression for the daily price-scrape job (default: 02:30 IST)
GENUINE_RX_SCRAPE_CRON=30 21 * * *

# --- Price-drop email alerts (all optional) ---
# Leave SMTP empty for demo mode: emails are saved as HTML in rpa/outbox/.
# For real email with Gmail: enable 2-Step Verification, then create an
# "App Password" at https://myaccount.google.com/apppasswords and paste it here.
GENUINE_RX_SMTP_USER=
GENUINE_RX_SMTP_PASSWORD=
# Demo shortcut: send EVERY user's alerts to this one address (skips per-user emails)
GENUINE_RX_ALERT_TO_EMAIL=
# Ignore price drops smaller than this percentage
GENUINE_RX_ALERT_MIN_DROP_PCT=0.5
